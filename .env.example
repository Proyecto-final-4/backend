# =============================================================================
# finanzIA — Backend (Spring Boot)
# Copiar a .env y reemplazar los placeholders. No commitear .env con secretos reales.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5439/backend-4
SPRING_DATASOURCE_USERNAME=backend
SPRING_DATASOURCE_PASSWORD=backend

# Cifrado en tránsito (JDBC → PostgreSQL)
# prefer = intenta SSL; si el servidor no lo soporta, conecta sin SSL (desarrollo local)
# require = obliga SSL (recomendado en producción)
SPRING_DATASOURCE_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------

# JWT — firma de tokens (mín. 32 caracteres en desarrollo)
APP_JWT_SECRET=replace_with_dev_jwt_secret_min_32_chars

# Cifrado en reposo (AES-256-GCM) — columnas sensibles en BD (email, nombre, descripciones…)
# Obligatorio. Debe ser Base64 de exactamente 32 bytes (256 bits).
# Generar: openssl rand -base64 32
# No rotar sin plan de re-cifrado: los datos existentes quedarían ilegibles.
APP_ENCRYPTION_KEY=replace_with_base64_32bytes_key

# Login/registro: credenciales cifradas con RSA-OAEP en el cliente (GET /auth/public-key).
# No requiere variables de entorno; el par RSA se genera al arrancar el servidor.

# -----------------------------------------------------------------------------
# Spring AI / OpenAI (embeddings + pgvector)
# -----------------------------------------------------------------------------
SPRING_AI_OPENAI_API_KEY=replace_with_real_openai_key
SPRING_AI_OPENAI_EMBEDDING_OPTIONS_MODEL=text-embedding-3-small
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
SPRING_AI_VECTORSTORE_PGVECTOR_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# LocalStack / AWS SDK (fase futura — desarrollo local)
# -----------------------------------------------------------------------------
SPRING_CLOUD_AWS_ENDPOINT=http://localhost:4666
SPRING_CLOUD_AWS_REGION_STATIC=us-east-1
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=test
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=test

# -----------------------------------------------------------------------------
# Usuario inicial (UserSeeder) — opcional
# -----------------------------------------------------------------------------
SEED_USER_EMAIL=admin@finanzia.local
SEED_USER_PASSWORD=replace_with_seed_password
SEED_USER_NAME=Admin

# -----------------------------------------------------------------------------
# Validación de entorno al arrancar (opcional)
# -----------------------------------------------------------------------------
# app.env.validation.enabled=true
