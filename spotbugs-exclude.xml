<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    JPA entities and Spring-managed beans require direct getters/setters over managed
    object references. Defensive copying is not applicable and would break the
    persistence context or Spring's dependency injection. EI_EXPOSE_REP / EI_EXPOSE_REP2
    are false positives for all domain, security and shared Spring components.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Package name="~com\.backend\.backend\.(domain|security|shared).*"/>
  </Match>

  <!--
    Services intentionally throw RuntimeException (e.g. EntityNotFoundException,
    IllegalArgumentException) as part of the application's error-handling strategy.
    These are mapped to HTTP responses by GlobalExceptionHandler.
    EncryptionService and EncryptionDataMigrationRunner also use RuntimeException wrappers
    for checked crypto exceptions that cannot propagate through the call stack.
  -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    <Package name="~com\.backend\.backend\.(domain|shared).*"/>
  </Match>

  <!--
    Spring Security's HttpSecurity API declares throws Exception by design.
    AuthenticationConfiguration.getAuthenticationManager() also throws Exception.
    These cannot be made more specific without modifying Spring's own interfaces.
  -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    <Package name="~com\.backend\.backend\.security.*"/>
  </Match>

  <!--
    VectorFloatConverter.convertToEntityAttribute intentionally returns null when
    the database column is NULL — this is the correct JPA AttributeConverter contract.
    Returning new float[0] would misrepresent a missing embedding as an empty one.
  -->
  <Match>
    <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/>
    <Class name="com.backend.backend.domain.transaction.VectorFloatConverter"/>
  </Match>

  <!--
    ApplicationContextProvider implements the standard Spring ApplicationContextAware
    pattern. Writing to the static field from the instance setter is required by the
    interface contract and is safe because Spring guarantees single-threaded context
    initialization before any beans are used.
  -->
  <Match>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    <Class name="com.backend.backend.shared.crypto.ApplicationContextProvider"/>
  </Match>
</FindBugsFilter>
